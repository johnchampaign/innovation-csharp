<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Innovation.Wpf</RootNamespace>
    <!-- Version string surfaces in the Bug Report dialog so reports are
         tagged with the build that produced them. Bump when cutting a
         new release. -->
    <Version>0.1.21</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Innovation.Core\Innovation.Core.csproj" />
  </ItemGroup>

  <!-- VB6 icon art (6 gameplay icons in full + _small, 5 card colors,
       5 special achievement crests, plus x.jpg for the hex slot and
       title.jpg) shipped as embedded WPF resources, accessed from
       CardVisuals via pack://application URIs. -->
  <ItemGroup>
    <Resource Include="Resources\*.jpg" />
  </ItemGroup>

  <!-- Bug-report service token. Set BUGREPORT_GITHUB_TOKEN before
       `dotnet publish` for releases; the token is embedded in the
       binary as an AssemblyMetadata attribute and read at runtime by
       BugReportSubmitter. Source builds without the env var set get
       an empty string and the dialog shows a "submit unavailable"
       message — which is the right behaviour, since dev builds
       shouldn't punch into the production token's quota. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BugReportToken</_Parameter1>
      <_Parameter2>$(BUGREPORT_GITHUB_TOKEN)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
